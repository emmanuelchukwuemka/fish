# Generate a password hash with:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('CHANGE_ME'))"
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-generated-password-hash
DATABASE_PATH=phishlab.db
BASE_URL=http://127.0.0.1:5000
PORT=5000

# Delivery mode: "simulation" (default) never touches the network — messages are
# appended to SIMULATION_LOG_PATH for review. Set to "smtp" to actually send via
# the SMTP settings below. Both modes still enforce the TEST_RECIPIENTS allowlist.
DELIVERY_MODE=simulation
SIMULATION_LOG_PATH=simulation_outbox.log

# SMTP settings (use a dedicated test mailbox/provider account; only used when DELIVERY_MODE=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated explicit test inbox allowlist. Delivery is blocked without this.
TEST_RECIPIENTS=your-test-inbox@example.com

# Gammadyne Mailer integration (optional alternative to SMTP/simulation, used via
# the dashboard's dry-run/approve workflow, not the DELIVERY_MODE setting above).
# Keep these paths private — never commit them or paste them into chat/tickets.
GAMMADYNE_EXE_PATH=
# A Gammadyne project (.mmp) you have already created and saved in the Gammadyne
# GUI, with its SMTP/sending settings configured. Its own recipient list and
# subject/body are irrelevant — PhishLab overrides them on every live call so
# only the allowlisted recipient and campaign content are ever actually used.
GAMMADYNE_PROJECT_PATH=
GAMMADYNE_TIMEOUT_SECONDS=120
# Leave false until you've reviewed integrations/gammadyne.py yourself and are
# ready to let "Approve & send via Gammadyne" actually invoke gm.exe. The
# switches used are documented (see that file's module docstring), but this
# flag is a deliberate, separate admin opt-in beyond that.
GAMMADYNE_SYNTAX_VERIFIED=false
