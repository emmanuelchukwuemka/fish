# Generate a password hash with:
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('CHANGE_ME'))"
FLASK_SECRET_KEY=8e6b1f2cd76fb6c4bfb5adcc248b7e3a2a5b2811ae23d09d7ceeb44f05f5c7ee
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$fqaIY7DnZbGrbsIq$38c7f03e184535943d291945acb7965d345d4707dc1b61b15db6a893a11428ba67efae8dedbeba88c78bd6f9358a750e2e5bfdec497ba84d27256636937510c2
DATABASE_PATH=phishlab.db
BASE_URL=http://127.0.0.1:5000
PORT=5000

# Delivery mode: "simulation" (default) never touches the network — messages are
# appended to SIMULATION_LOG_PATH for review. Set to "smtp" to actually send via
# the SMTP settings below. Both modes still enforce the TEST_RECIPIENTS allowlist.
DELIVERY_MODE=simulation
SIMULATION_LOG_PATH=simulation_outbox.log

# SMTP settings (use a dedicated test mailbox/provider account; only used when DELIVERY_MODE=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated explicit test inbox allowlist. Delivery is blocked without this.
TEST_RECIPIENTS=your-test-inbox@example.com
